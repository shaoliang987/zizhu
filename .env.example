# BTC 5m Up/Down pair strategy bot — environment template
# Copy to .env and fill in values. Never commit .env with real keys.

# ── Mode (start scripts override these) ─────────────────────────────
DRY_RUN=true
# LOCK_MODE=true
# INSTANCE_NAME=paper
# PORT=8087
# STATE_DIR=./data/paper
# STRATEGY_PARAMS_FILE=./strategy_params.json

# ── HTTP / security ─────────────────────────────────────────────────
# Default: localhost only. Set 0.0.0.0 only behind a reverse proxy + firewall.
BIND_HOST=127.0.0.1
# When set, all POST /api/* require Authorization: Bearer <token>
# BOT_API_TOKEN=change-me-to-a-long-random-string

# ── Polymarket CLOB (required for live) ─────────────────────────────
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# Signature type: 1 Magic/Email, 2 browser wallet, 3 deposit wallet
POLYMARKET_SIGNATURE_TYPE=3
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137

# ── WebSocket quotes ────────────────────────────────────────────────
# CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# WS_QUOTE_MAX_AGE_MS=8000
# WS_BOOK_MAX_AGE_MS=8000
# WS_QUOTE_WAIT_MS=350

# ── On-chain redeem (live) ──────────────────────────────────────────
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# RPC_URL=https://polygon-bor-rpc.publicnode.com
# POLYMARKET_CTF_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
# POLYMARKET_USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
# POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com/
# Deposit wallet(type=3) / proxy / safe 赎回走 Polymarket relayer（与官方自动赎回同路径）：
# POLY_BUILDER_API_KEY=
# POLY_BUILDER_SECRET=
# POLY_BUILDER_PASSPHRASE=
# 若已开启官方自动赎回，可跳过机器人链上赎回，仅同步状态：
# POLYMARKET_SKIP_BOT_REDEEM=1

# ── Risk / ops tuning ───────────────────────────────────────────────
# UNWIND_MAX_ROUNDS=8
# REDEEM_RETRY_LIMIT=50
# TAKER_FEE_RATE=0.07

# ── Misc ────────────────────────────────────────────────────────────
FETCH_TIMEOUT_MS=8000
TZ=Asia/Hong_Kong
DISPLAY_TZ=Asia/Hong_Kong
